---
import { site } from '../data/site';
import Icon from './Icon.astro';
// 'buttons' (default): pill buttons. 'text': small icon-and-label links, so they don't compete
// with the main buttons next to them (used in the hero).
interface Props { variant?: 'buttons' | 'text'; }
const { variant = 'buttons' } = Astro.props;
const labels: Record<string, string> = { linkedin: 'LinkedIn', github: 'GitHub', scholar: 'Google Scholar', orcid: 'ORCID' };
const icons: Record<string, 'linkedin' | 'github' | 'orcid'> = { linkedin: 'linkedin', github: 'github', orcid: 'orcid' };
const links = Object.entries(site.links).filter(([, url]) => url);
---
{links.length > 0 && (
  <ul class:list={['links', variant]}>
    {links.map(([k, url]) => (
      <li><a class={variant === 'buttons' ? 'btn' : 'text-link'} href={url} target="_blank" rel="noopener">{icons[k] && <Icon name={icons[k]} size={16} />}{labels[k]}</a></li>
    ))}
  </ul>
)}
<style>
  .links { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .links .btn { padding: 0.5rem 0.9rem; font-size: 0.88rem; gap: 0.45rem; }
  .links.text { gap: 0.2rem 1.4rem; }
  .text-link {
    display: inline-flex; align-items: center; gap: 0.4rem; padding-block: 0.6rem;
    color: var(--muted); font-size: 0.92rem; font-weight: 500; text-decoration: none;
  }
  @media (hover: hover) and (pointer: fine) { .text-link:hover { color: var(--ink); } }
  .text-link:active { color: var(--ink); }
</style>
