// github from v0.469.0, the last releases that still include brand marks.
// Filled icon: ORCID from Simple Icons v16.34.0 (CC0).
interface Props { name: keyof typeof icons; size?: number; }
const { name, size = 18 } = Astro.props;

const icons = {
  download: { fill: false, body: '<path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/>' },
