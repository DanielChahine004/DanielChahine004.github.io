---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Links from '../components/Links.astro';
import PetScanner from '../components/PetScanner.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Img from '../components/Img.astro';
import { site, publications } from '../data/site';

const projects = (await getCollection('projects', (p) => !p.data.hidden)).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured).slice(0, 6);
// Projects with their own page link there; the rest open from the projects page.
const linkFor = (p: (typeof projects)[number]) => (p.data.page ? `/projects/${p.id}` : p.data.href ?? '/projects');
// Bold my name in author lists.
const authorParts = (authors: string) => authors.split(/(D\. Chahine)/);
---
<Base>
  <section class="hero wrap">
    <div class="hero-text">
      <h1>{site.name}</h1>
      <p class="lede">{site.intro}</p>
      <div class="cta">
        <a class="btn primary" href={site.resume} download={site.resumeFilename}><Icon name="download" />Download CV</a>
        <a class="btn" href="/projects"><Icon name="grid" />View projects</a>
      </div>
      <Links variant="text" />
    </div>
    <div class="hero-photo">
      <PetScanner src={site.photo} alt={`Portrait of ${site.name}`} />
    </div>
  </section>

  <section class="section" id="about">
    <div class="wrap about">
      <div>
        <h2>About</h2>
        {site.bio.map((p) => <p>{p}</p>)}
      </div>
      <aside class="facts">
        <h3>Education</h3>
        <ul class="edu">
          {site.education.map((e) => (
            <li>
              {e.logo && <img class="edu-logo" src={e.logo} alt={e.org} width="44" height="18" />}
              <div>
                <strong>{e.title}</strong>
                <span class="muted">{e.org} · {e.period}{e.note && ` · ${e.note}`}</span>
              </div>
            </li>
          ))}
        </ul>
        <h3>Toolkit</h3>
        <ul class="chips">{site.skills.map((s) => <li class="chip">{s}</li>)}</ul>
      </aside>
    </div>
    <div class="wrap">
      <h3 class="affil-label">Where I’ve studied and worked</h3>
      <ol class="affils">
        {site.affiliations.map((a) => (
          <li>
            <span class="tile"><img src={a.logo} alt={a.name} title={a.name} loading="lazy" /></span>
            <span class="affil-meta"><strong>{a.period}</strong> {a.role}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="research">
    <div class="wrap research">
      <div>
        <h2>Current research</h2>
        <p>{site.research.intro}</p>
        <dl class="research-points">
          {site.research.areas.map((a) => <div><dt>{a.title}</dt><dd>{a.text}</dd></div>)}
        </dl>
      </div>
      <a class="research-figure" href="/projects/pet-reconstruction">
        <Img src="pet-recon-cover.png" alt="Reconstructed PET image of a simulated NEMA IEC phantom: four hot spheres" width={720} />
        <span class="caption">A simulated NEMA phantom, reconstructed by my Honours thesis pipeline →</span>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Featured projects</h2>
        <a href="/projects">All projects →</a>
      </div>
      <div class="grid featured">
        {featured.map((p, i) => <ProjectCard project={p} size={i === 0 ? 'wide' : 'large'} />)}
      </div>
    </div>
  </section>

  <section class="section" id="publications">
    <div class="wrap">
      <div class="section-head"><h2>Publications</h2></div>
      <!-- A citation list, not cards: title, authors (me in bold), venue, then status or note. -->
      <ol class="pubs">
        {publications.map((p) => (
          <li>
            {p.url
              ? <a class="pub-title" href={p.url} target="_blank" rel="noopener">{p.title}<Icon name="external" size={16} /></a>
              : <span class="pub-title">{p.title}</span>}
            <span class="authors">{authorParts(p.authors).map((s) => s === 'D. Chahine' ? <strong>{s}</strong> : s)}</span>
            <span class="venue"><em>{p.venue}</em>{p.status !== 'Published' && ` · ${p.status}`}{p.note && ` · ${p.note}`}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Other projects</h2>
        <a href="/projects">See all →</a>
      </div>
      <!-- A compact list, so it doesn't repeat the featured grid. -->
      <ul class="others">
        {others.map((p) => (
          <li>
            <a href={linkFor(p)}>{p.data.title}</a>
            <span class="muted">{p.data.category}{p.data.period && ` · ${p.data.period}`}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(2rem, 5vw, 4rem);
    align-items: center; padding-block: clamp(3rem, 8vw, 6rem);
  }
  .hero h1 { margin-bottom: 0.35em; font-size: clamp(2.75rem, 6vw, 4.5rem); line-height: 1.02; letter-spacing: -0.025em; }
  .lede { font-size: clamp(1.15rem, 2vw, 1.35rem); color: var(--muted); max-width: 34ch; margin-bottom: 1.8rem; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 1.2rem; }
  .hero-photo { justify-self: end; width: min(100%, 420px); }
  .about { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(2rem, 5vw, 4rem); }
  .about p { max-width: 62ch; }
  .facts { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem; align-self: start; }
  .facts h3 { font-size: 1.05rem; margin-bottom: 0.8rem; }
  .facts h3 + * { margin-bottom: 1.6rem; }
  .edu-logo { height: 18px; width: auto; margin-top: 0.15rem; }
  /* The logo is black; show it white on the dark theme. */
  @media (prefers-color-scheme: dark) { .edu-logo { filter: invert(1); } }
  .facts .chips { margin-bottom: 0; }
  .edu { list-style: none; padding: 0; display: grid; gap: 0.9rem; }
  /* Logo column beside each entry, so the text lines up even if an entry has no logo. */
  .edu li { display: grid; grid-template-columns: 44px 1fr; gap: 0.8rem; align-items: start; font-size: 0.95rem; line-height: 1.4; }
  .edu li > div { display: grid; gap: 0.15rem; grid-column: 2; }
  /* Affiliations: white logo tiles (readable in both themes), oldest first, wrapping on small screens. */
  .affil-label { margin-top: clamp(2.5rem, 5vw, 3.5rem); font-size: 1.05rem; }
  .affils {
    list-style: none; padding: 0; margin: 0.8rem 0 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: 1rem 0.9rem;
  }
  .affils li { display: grid; gap: 0.45rem; align-content: start; }
  .tile {
    display: grid; place-items: center; height: 68px; padding: 0.6rem 0.8rem;
    background: #fff; border: 1px solid var(--line); border-radius: 12px;
  }
  .tile img { max-width: 100%; max-height: 44px; width: auto; height: auto; object-fit: contain; }
  .affil-meta { font-size: 0.78rem; line-height: 1.35; color: var(--muted); }
  .affil-meta strong { display: block; color: var(--ink); font-weight: 600; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 1.25rem; }
  /* Featured: the lead project spans the row, the rest sit two across (one column on phones). */
  .grid.featured { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .grid.featured > :global(.card:first-of-type) { grid-column: 1 / -1; }
  @media (max-width: 680px) { .grid.featured { grid-template-columns: 1fr; } }
  /* Research: the text and its four areas on the left, a real reconstruction on the right. */
  .research { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .research p { max-width: 62ch; }
  .research-points { margin: 1.6rem 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.1rem 1.5rem; }
  .research-points div { display: grid; gap: 0.15rem; line-height: 1.4; }
  .research-points dt { font-weight: 600; color: var(--ink); }
  .research-points dd { margin: 0; font-size: 0.92rem; color: var(--muted); }
  .research-figure { display: grid; gap: 0.6rem; text-decoration: none; color: var(--muted); }
  .research-figure :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius); background: #0d0303; }
  .research-figure .caption { font-size: 0.85rem; line-height: 1.4; }
  @media (hover: hover) and (pointer: fine) { .research-figure:hover .caption { color: var(--accent); } }
  @media (max-width: 820px) {
    .research { grid-template-columns: 1fr; }
    .research-figure { max-width: 420px; }
  }
  /* Small phones: one area per row, or "reconstruction" runs out of room. */
  @media (max-width: 480px) { .research-points { grid-template-columns: 1fr; } }
  /* Publications read as citations: no boxes, separated by space. */
  .pubs { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.8rem; max-width: 75ch; }
  .pubs li { display: grid; gap: 0.3rem; }
  .authors, .venue { font-size: 0.95rem; color: var(--muted); }
  .authors strong { color: var(--ink); font-weight: 600; }
  .pub-title { font: 600 1.2rem/1.3 var(--serif); color: var(--ink); text-decoration: none; }
  /* Other projects: a quiet two-column list of titles. */
  .others { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 1.1rem 2.5rem; }
  .others li { display: grid; gap: 0.15rem; }
  .others a { color: var(--ink); font-weight: 600; text-decoration: none; }
  .others .muted { font-size: 0.85rem; }
  @media (hover: hover) and (pointer: fine) { .others a:hover { color: var(--accent); } }
  /* Linked titles: an arrow and an underline on hover make it clear they open the paper. */
  a.pub-title { text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 0.2em; transition: color 0.15s, text-decoration-color 0.15s; }
  a.pub-title :global(.icon) { margin-left: 0.3em; color: var(--accent); vertical-align: -0.15em; }
  @media (hover: hover) and (pointer: fine) {
    a.pub-title:hover { color: var(--accent); text-decoration-color: currentColor; }
  }
  @media (max-width: 820px) {
    .hero, .about { grid-template-columns: 1fr; }
    .hero-photo { justify-self: center; order: -1; width: min(100%, 300px); }
  }
</style>
