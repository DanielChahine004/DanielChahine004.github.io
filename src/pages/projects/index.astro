---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const categories = ['Research', 'Software', 'Design', 'Coursework', 'Industry'] as const;
const groups = categories
  .map((c) => ({ c, items: projects.filter((p) => !p.data.featured && p.data.category === c) }))
  .filter((g) => g.items.length);
---
<Base title="Projects" description="Research, engineering and software projects by Daniel Chahine.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Projects</p>
      <h1>Things I’ve built and studied</h1>
      <p class="muted intro">Research scholarships, industry engineering, software and design work, from quantum hardware to brain imaging.</p>
      <h2 class="group">Featured</h2>
      <div class="grid">{featured.map((p) => <ProjectCard project={p} size="large" />)}</div>
      {groups.map((g) => (
        <>
          <h2 class="group">{g.c}</h2>
          <div class="grid">{g.items.map((p) => <ProjectCard project={p} />)}</div>
        </>
      ))}
    </div>
  </section>
</Base>

<style>
  .intro { max-width: 60ch; font-size: 1.1rem; }
  .group { margin: 3rem 0 1.25rem; font-size: 1.4rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 1.25rem; }
</style>
