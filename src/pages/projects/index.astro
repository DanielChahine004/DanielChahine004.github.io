---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects', (p) => !p.data.hidden)).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const categories = ['Research', 'Software', 'Design', 'Coursework', 'Industry'] as const;
// Each category's projects are already ranked by `order`; the categories themselves are ranked
// by their best project, so the strongest work leads the page.
const groups = categories
  .map((c) => ({ c, items: projects.filter((p) => !p.data.featured && p.data.category === c) }))
  .filter((g) => g.items.length)
  .sort((a, b) => a.items[0].data.order - b.items[0].data.order);
---
<Base title="Projects" description="Research, engineering and software projects by Daniel Chahine.">
  <section class="section">
    <div class="wrap">
      <h1>Things I’ve built and studied</h1>
      <p class="muted intro">Research scholarships, industry engineering, software and design work, from quantum hardware to brain imaging.</p>
      <h2 class="group">Featured</h2>
      <div class="grid featured">{featured.map((p, i) => <ProjectCard project={p} size={i === 0 ? 'wide' : 'large'} />)}</div>
      {groups.map((g) => (
        <>
          <h2 class="group">{g.c}</h2>
          <div class="grid">{g.items.map((p) => <ProjectCard project={p} />)}</div>
        </>
      ))}
    </div>
  </section>
</Base>

<style>
  .intro { max-width: 60ch; font-size: 1.1rem; }
  .group { margin: 3rem 0 1.25rem; font-size: 1.4rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 1.25rem; }
  /* Featured: the lead project spans the row, the rest sit two across (one column on phones). */
  .grid.featured { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .grid.featured > :global(.card:first-of-type) { grid-column: 1 / -1; }
  @media (max-width: 680px) { .grid.featured { grid-template-columns: 1fr; } }
</style>
